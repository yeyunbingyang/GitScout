# Copy this file to the repository root as .env.
# Process environment variables override values from this file.
GITSCOUT_DATA_DIR=data
GITSCOUT_CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
GITSCOUT_LOG_LEVEL=INFO

# Optional GitHub token. Backend only; never expose it to the browser.
GITHUB_TOKEN=

# Optional override for the GitHub Trending HTML source.
GITSCOUT_TRENDING_URL=https://github.com/trending

# Optional Search API request spacing override in seconds. Default: 2.1 with token, 6.1 without.
# GITSCOUT_GITHUB_SEARCH_INTERVAL_SECONDS=2.1
